    "@solidjs/web": "2.0.0-rc.7",
    "astro": "7.3.2",
    "octokit": "^5.0.5",
    "solid-js": "2.0.0-rc.7",
    "tailwindcss": "4.3.3",
    "websim": "0.1.0"
  },
  "devDependencies": {
    "@astrojs/solid-js": "7.0.2",
    "@biomejs/biome": "2.5.12",
    "@gameroman/config": "0.2.9",
    "@rolldown-plugin/solid": "https://pkg.pr.new/rolldown-plugin/solid/@rolldown-plugin/solid@a1e46df",
    "@tailwindcss/vite": "4.3.3",
    "@violentmonkey/types": "0.3.4",
    "usts": "0.1.1",
    "wrangler": "4.130.0"
